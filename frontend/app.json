{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "happyhour",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.localdealsnow.iyks42",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan customer QR codes and record promo videos",
        "NSMicrophoneUsageDescription": "Record audio for your promo videos",
        "NSPhotoLibraryUsageDescription": "Upload store photos and promo videos",
        "NSLocationWhenInUseUsageDescription": "Show you deals from nearby merchants"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.localdealsnow.iyks42",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan customer QR codes and record promo videos.",
          "microphonePermission": "Record audio for your promo videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload store photos and promo videos.",
          "cameraPermission": "Record promo videos from your store."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
